		(at 20.32 200.66 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "688a4179-d073-54a8-bb56-47debd6092a6")
	)
	(text "6. Comparators: LM393 on +5 V, inputs <= 3.6 V, outputs -> 3.3 V"
		(exclude_from_sim no)
		(at 152.4 147.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "955b214d-6e2b-5777-a8f4-8d3e72d90426")
	)
	(text "Sensor input modes (selected in the app; firmware drives HALL_*_EN):"
		(exclude_from_sim no)
		(at 312.42 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c3fb049f-ee8a-5a2a-808a-ec3c83fea958")
	)
	(text "  Hall 3.3 V : U5 on  -> RING ~3.0 V (after D6). Read SENSOR_OUT (GPIO3)."
		(exclude_from_sim no)
		(at 312.42 180.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "99623fda-149b-5367-8949-9ad2d8b953d4")
	)
	(text "  Hall 5 V   : U6 on  -> RING ~4.7 V (after D7). Read SENSOR_OUT (GPIO3)."
		(exclude_from_sim no)
		(at 312.42 183.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "392f95a8-9b5f-50c7-94ae-657c7335cd69")
	)
	(text "  Concept2   : both off (RING unpowered). Read COIL_OUT (GPIO6)."
		(exclude_from_sim no)
		(at 312.42 186.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cc6b926a-69a7-5ea2-ad51-38cd0956c3b0")
	)
	(text "Jack wiring:"
		(exclude_from_sim no)
		(at 312.42 191.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9d9044f4-8ef0-53f5-bd07-87da442b1a4b")
	)
	(text "  Concept2 C   : mono plug, TIP = coil (~100 Ohm), RING shorted to SLEEVE."
		(exclude_from_sim no)
		(at 312.42 194.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3d0de756-3eb7-549f-a30c-554443bfca75")
	)
	(text "  Concept2 D/E : TIP = tacho 0-18 V, RING = generator DC ~18 V."
		(exclude_from_sim no)
		(at 312.42 197.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8548862c-550e-5ddd-b126-3c2d66e3a6ba")
	)
	(text "  Hall sensor  : TIP = output, RING = VCC from U5/U6, SLEEVE = GND."
		(exclude_from_sim no)
		(at 312.42 200.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ba3d6f68-d598-56ae-a3fa-0256d7061ebf")
	)
	(text "Comparator A (DC): threshold 1.65 V, hysteresis ~156 mV. Hall sensors"
		(exclude_from_sim no)
		(at 312.42 205.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4357c78e-9ddd-5bb1-b7cc-9bf29274079c")
	)
	(text "  (open-collector via R10/D3 pull-up, or push-pull 3.3/5 V). Output HIGH"
		(exclude_from_sim no)
		(at 312.42 208.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0b268053-043b-5d30-ba79-a1118b5c773b")
	)
	(text "  while TIP is low (magnet present). Also toggles on the D/E tacho."
		(exclude_from_sim no)
		(at 312.42 211.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "36e180e5-d0ae-5f99-92a4-3c3e1e92072f")
	)
	(text "Comparator B (AC-coupled, fc ~2.7 Hz): zero-crossing with ~36 mV"
